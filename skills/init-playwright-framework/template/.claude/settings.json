{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node scripts/guard-hooks.mjs pre-bash",
                        "timeout": 10,
                        "statusMessage": "Stop rules: merge, default branch, production host, permission bypass"
                    }
                ]
            },
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node scripts/guard-hooks.mjs pre-edit",
                        "timeout": 10,
                        "statusMessage": "Stop rules: existing assertions, fixed sleeps"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d.trim());const f=j.tool_input?.file_path||j.tool_response?.filePath||'';if(f){require('child_process').execSync('npx prettier --write \"'+f+'\"',{stdio:'inherit'})}})\"",
                        "shell": "bash",
                        "timeout": 30,
                        "statusMessage": "Running prettier..."
                    },
                    {
                        "type": "command",
                        "command": "node scripts/guard-hooks.mjs post-edit",
                        "timeout": 60,
                        "statusMessage": "audit-suite on the repo (block-level rules)"
                    }
                ]
            }
        ]
    }
}
